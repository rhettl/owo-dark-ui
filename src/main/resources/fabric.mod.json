			"io.github.rhettl.owodarkui.OwoDarkUiClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"owo-lib": ">=0.12.15"
	},
	"custom": {
		"modmenu": {
			"badges": ["library"]
