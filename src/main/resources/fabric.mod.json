{
	"schemaVersion": 1,
	"id": "rhettl-owo-dark-ui",
	"version": "${version}",
	"name": "owo Dark UI",
	"description": "Themeable dark owo-lib UI components: frames, wells, tabs, lists, inventory grids, and an in-game component playground.",
	"authors": [
		"RhettL"
	],
	"contact": {
		"sources": "https://github.com/rhettl/owo-ui-components",
		"issues": "https://github.com/rhettl/owo-ui-components/issues"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.rhettl.owodarkui.OwoDarkUi"
		],
